# Copia este archivo a .env y completa los valores (Supabase → Project Settings → API).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Opcional: activa la resolución por subdominio (https://<slug>.tu-dominio.com).
# Déjalo vacío para usar solo https://tu-dominio.com/<slug>
VITE_BASE_DOMAIN=

# Clave pública VAPID (la clave privada solo vive en Supabase Edge Function Secrets).
VITE_VAPID_PUBLIC_KEY=
